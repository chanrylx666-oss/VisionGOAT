<Window x:Class="JPVision.WpfSample.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vision="clr-namespace:JPVision.Wpf;assembly=JPVision.Wpf" Title="JP-Vision · WPF 视觉工作站" Icon="pack://application:,,,/Assets/jpVision.ico" Width="1360" Height="880" MinWidth="900" MinHeight="620" Background="#09090B" FontFamily="Microsoft YaHei UI" FontSize="14">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22">
      <Image Source="Assets/jpVision.ico" Width="36" Height="36" Margin="0,0,12,0"/><TextBlock Text="JP-Vision" FontSize="30" FontWeight="SemiBold" Foreground="#F2F2F4"/>
      <TextBlock Text="视觉检测工作站" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0"/>
      <TextBlock x:Name="StateText" Text="初始化" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A6A6AC"/>
    </DockPanel>
    <StackPanel Grid.Row="1" x:Name="Commands" Orientation="Horizontal" Margin="0,0,0,18" IsEnabled="False">
      <Button x:Name="ImageButton" Content="打开图像" Click="OpenImage"/>
      <Button x:Name="RecipeButton" Content="加载配方" Click="OpenRecipe"/>
      <TextBlock Text="预期数量" VerticalAlignment="Center" Margin="10,0,8,0"/>
      <TextBox x:Name="Expected" Text="3" Width="70" Margin="0,0,16,0"/>
      <Button x:Name="RunButton" Content="单次检测" Click="SingleRun" Background="#9D1D28"/>
      <Button x:Name="ContinuousButton" Content="连续运行" Click="ContinuousRun"/>
      <Button x:Name="CancelButton" Content="取消" Click="CancelRun" IsEnabled="False"/>
      <Button Content="适应窗口" Click="FitImage"/>
      <CheckBox x:Name="OverlayToggle" Content="显示标记" IsChecked="True" Checked="ToggleOverlay" Unchecked="ToggleOverlay" Foreground="#F2F2F4" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="#101012" BorderBrush="#38383C" BorderThickness="1" CornerRadius="5" Margin="0,0,18,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="ImageTitle" Text="输入图像" Margin="16,12" Foreground="#A6A6AC"/>
          <vision:VisionView x:Name="ImageView" Grid.Row="1" Margin="4"/>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1">
        <Border Background="#18181B" Padding="20" CornerRadius="5" Margin="0,0,0,16">
          <StackPanel><TextBlock Text="检测结果" Foreground="#A6A6AC"/><TextBlock x:Name="DecisionText" Text="等待检测" FontSize="34" FontWeight="SemiBold" Margin="0,12,0,16"/><TextBlock x:Name="CountText" Text="目标数量 —" FontSize="18"/><TextBlock x:Name="TimeText" Text="算法耗时 —" Margin="0,10,0,0"/><TextBlock x:Name="RecipeText" Text="配方未加载" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#A6A6AC"/></StackPanel>
        </Border>
        <Border Background="#18181B" Padding="20" CornerRadius="5" Margin="0,0,0,16"><StackPanel><TextBlock Text="离线授权" FontWeight="SemiBold" Margin="0,0,0,12"/><vision:LicensePanel x:Name="LicenseControl"/></StackPanel></Border>
        <TextBlock Text="鼠标滚轮缩放 · 拖动平移&#x0a;相机与 PLC 由业务工程管理" Foreground="#A6A6AC" TextWrapping="Wrap" Margin="4,0"/>
        <TextBox x:Name="Diagnostics" IsReadOnly="True" TextWrapping="Wrap" Margin="0,18,0,0" MinHeight="100" MaxHeight="240" VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="PixelText" Text="X —  Y —" Foreground="#A6A6AC"/><TextBlock x:Name="RunIdText" HorizontalAlignment="Right" Text="运行号 —" Foreground="#A6A6AC"/></DockPanel>
  </Grid>
</Window>
