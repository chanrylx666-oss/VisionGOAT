<Window x:Class="JPVision.Studio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JPVision.Studio" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="JP-Vision · 机器视觉算法平台" Width="1580" Height="940" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Icon="Assets/jpVision.ico" Background="{StaticResource Background}" Foreground="{StaticResource Text}" FontFamily="Microsoft YaHei UI" FontSize="12">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#39393D" BorderThickness="1"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Border BorderBrush="#8D242B" BorderThickness="0,0,0,1"><Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#211114"/><GradientStop Color="#0C0C0E" Offset="0.3"/><GradientStop Color="#0C0C0E" Offset="0.85"/><GradientStop Color="#391418" Offset="1"/></LinearGradientBrush></Grid.Background>
      <StackPanel Orientation="Horizontal" Margin="18,0"><Image Source="Assets/jpVision.png" Width="30" Height="30"/><TextBlock Text="JP-Vision" FontSize="20" FontWeight="SemiBold" Margin="12,0,14,0"/><TextBlock Text="│ 机器视觉算法平台" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RecipeTitle" Text="未命名配方" Margin="20,0" Foreground="{StaticResource Muted}"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="─" Width="46" BorderThickness="0" Background="Transparent" Click="MinimizeClick"/><Button Content="□" Width="46" BorderThickness="0" Background="Transparent" Click="MaximizeClick"/><Button Content="✕" Width="46" Margin="0" BorderThickness="0" Background="Transparent" Click="CloseClick"/></StackPanel>
    </Grid></Border>
    <Menu Grid.Row="1"><MenuItem Header="文件(_F)"><MenuItem Header="新建配方" Click="NewClick" InputGestureText="Ctrl+N"/><MenuItem Header="打开配方" Click="OpenRecipeClick" InputGestureText="Ctrl+O"/><MenuItem Header="保存" Click="SaveClick" InputGestureText="Ctrl+S"/><MenuItem Header="另存为…" Click="SaveAsClick"/><Separator/><MenuItem Header="打开外部图像" Click="OpenImageClick"/></MenuItem><MenuItem Header="编辑(_E)"><MenuItem Header="撤销" Click="UndoClick" InputGestureText="Ctrl+Z"/><MenuItem Header="重做" Click="RedoClick" InputGestureText="Ctrl+Y"/><MenuItem Header="复制所选算子" Click="DuplicateClick" InputGestureText="Ctrl+D"/><MenuItem Header="删除节点" Click="DeleteClick" InputGestureText="Delete"/><MenuItem Header="公开输出与判定…" Click="InterfacesClick"/><MenuItem Header="变量与计算函数…" Click="VariablesClick"/></MenuItem><MenuItem Header="运行(_R)"><MenuItem Header="校验流程" Click="ValidateClick"/><MenuItem Header="执行" Click="RunClick" InputGestureText="F5"/><MenuItem Header="执行到选中算子" Click="RunSelectedClick"/></MenuItem><MenuItem Header="设备(_D)"><MenuItem x:Name="CameraManageMenu" Header="全局相机管理…" Click="CameraManageClick"/></MenuItem><MenuItem Header="授权(_L)" Click="LicenseClick"/><MenuItem Header="帮助(_H)"><MenuItem Header="操作说明" Click="HelpClick"/><MenuItem Header="关于 JP-Vision" Click="AboutClick"/></MenuItem></Menu>
    <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,7"><DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><CheckBox x:Name="KeepPreviews" Content="保留中间结果" IsChecked="True" Margin="0,0,14,0" ToolTip="保留全部算子的图像和完整结果；关闭后保留本次选中算子"/><Button Content="授权" Click="LicenseClick"/></StackPanel>
      <WrapPanel x:Name="Toolbar" Orientation="Horizontal"><Button Content="▣ 新建配方" Click="NewClick"/><Button Content="▱ 打开配方" Click="OpenRecipeClick"/><Button Content="▣ 保存" Click="SaveClick"/><Border Width="1" Background="{StaticResource Border}" Margin="5,3,13,3"/><Button Content="▧ 打开图像" Click="OpenImageClick"/><ComboBox x:Name="CameraSourceChoice" Width="108" Margin="0,0,5,0" SelectionChanged="CameraSourceChanged" ToolTip="所有外部图像节点共享此图像源；相机每次执行等待一张新帧"><ComboBoxItem Content="文件图像"/><ComboBoxItem Content="全局相机"/></ComboBox><Button x:Name="CameraManageButton" Content="相机管理" Click="CameraManageClick"/><Button Content="☑ 校验流程" Click="ValidateClick"/><Button x:Name="ExecuteButton" Content="▶ 执行" Style="{StaticResource PrimaryButton}" Click="RunClick"/><Button Content="执行到选中" Click="RunSelectedClick"/><Button x:Name="CancelButton" Content="■ 取消" Click="CancelClick" IsEnabled="False"/><Button Content="ROI 编辑" Click="RoiClick"/></WrapPanel>
    </DockPanel></Border>
    <Grid Grid.Row="3" Margin="8,8,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="232" MinWidth="200"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="310" MinWidth="265"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="7"/><RowDefinition Height="118" MinHeight="80"/></Grid.RowDefinitions>
      <Border Grid.RowSpan="3" Style="{StaticResource Panel}"><DockPanel><Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="13,11"><TextBlock Text="算法工具箱" FontWeight="SemiBold" FontSize="14"/></Border><TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="10" ToolTip="搜索算子" TextChanged="SearchChanged"/><Button DockPanel.Dock="Bottom" Content="＋ 插入选中算子" Style="{StaticResource PrimaryButton}" Margin="10" Click="InsertClick"/><ScrollViewer><StackPanel x:Name="Toolbox" Margin="8,0,8,8"/></ScrollViewer></DockPanel></Border>
      <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent" Grid.RowSpan="3"/>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="1.1*" MinHeight="220"/><RowDefinition Height="7"/><RowDefinition Height="*" MinHeight="215"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Panel}"><DockPanel><Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,7"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="－" Padding="10,3" Click="GraphZoomOutClick"/><Button Content="＋" Padding="10,3" Click="GraphZoomInClick"/><Button Content="适应窗口" Padding="10,3" Click="GraphFitClick"/><TextBlock x:Name="GraphZoom" Text="100%" Margin="4,0"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="JP-Vision" Foreground="{StaticResource Accent}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text=" /  流程编辑" FontSize="16" Margin="8,0"/></StackPanel></DockPanel></Border><local:GraphView x:Name="Graph" ClipToBounds="True"/></DockPanel></Border>
        <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch" Background="Transparent"/>
        <Border Grid.Row="2" Style="{StaticResource Panel}"><DockPanel><Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,7"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="－" Padding="9,3" Click="ImageZoomOutClick"/><Button Content="＋" Padding="9,3" Click="ImageZoomInClick"/><Button Content="适应窗口" Padding="9,3" Click="ImageFitClick"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="图像与中间结果" FontWeight="SemiBold" FontSize="14" Margin="0,0,12,0"/><ComboBox x:Name="ImageChoice" Width="128" SelectionChanged="ImageChoiceChanged"><ComboBoxItem Content="算子输出"/><ComboBoxItem Content="原图"/><ComboBoxItem Content="算子输入"/><ComboBoxItem Content="实时画面"/></ComboBox><CheckBox x:Name="ShowMarks" Content="显示标记" IsChecked="True" Margin="12,0" Checked="ShowMarksChanged" Unchecked="ShowMarksChanged"/></StackPanel></DockPanel></Border><Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,5"><DockPanel><TextBlock x:Name="PixelText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ImageInfo" Text="打开图像开始调试" Foreground="{StaticResource Muted}"/></DockPanel></Border><local:ImageEditorView x:Name="ImageView" ClipToBounds="True"/></DockPanel></Border>
      </Grid>
      <GridSplitter Grid.Column="3" Width="7" HorizontalAlignment="Stretch" Background="Transparent" Grid.RowSpan="3"/>
      <Border Grid.Column="4" Style="{StaticResource Panel}" Grid.RowSpan="3"><DockPanel><Border DockPanel.Dock="Top" Padding="12,11" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"><DockPanel><TextBlock x:Name="NodeState" DockPanel.Dock="Right" Text="等待执行" Foreground="{StaticResource Muted}"/><TextBlock Text="参数与结果" FontSize="14" FontWeight="SemiBold"/></DockPanel></Border><TabControl x:Name="InspectorTabs"><TabItem Header="算子参数"><ScrollViewer><StackPanel x:Name="Parameters" Margin="12"/></ScrollViewer></TabItem><TabItem Header="运行结果"><ScrollViewer><StackPanel x:Name="Results" Margin="12"/></ScrollViewer></TabItem></TabControl></DockPanel></Border>
      <GridSplitter Grid.Row="1" Grid.Column="2" Height="7" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Panel}"><DockPanel><Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,6"><DockPanel><Button Content="清空日志" Padding="8,2" Click="ClearLogClick" DockPanel.Dock="Right"/><TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold"/></DockPanel></Border><ListBox x:Name="LogList" FontFamily="Consolas,Microsoft YaHei UI" FontSize="11"/></DockPanel></Border>
    </Grid>
    <Border Grid.Row="4" Padding="14,3"><DockPanel><TextBlock Text="C++ OpenCV 5.0  │  WPF 本地执行  │  JP-Vision v0.7.2" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CameraSourceStatus" DockPanel.Dock="Right" Margin="0,0,16,0" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatusText" Text="检查授权…" Foreground="{StaticResource Muted}"/></DockPanel></Border>
  </Grid></Border>
</Window>
