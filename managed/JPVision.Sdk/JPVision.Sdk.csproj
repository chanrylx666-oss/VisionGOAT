<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><PlatformTarget>x64</PlatformTarget>
    <PackageId>JPVision.Sdk</PackageId><Version>0.7.2</Version><Authors>JP</Authors>
    <Description>JP-Vision licensed native machine vision runtime SDK for Windows x64.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile><NoWarn>$(NoWarn);1591</NoWarn>
    <_OpenCvSuffix Condition="'$(Configuration)' == 'Debug'">d</_OpenCvSuffix>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/sdk-integration.md" Pack="true" PackagePath="README.md" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="notices/" />
    <None Include="../../third_party/licenses/OpenCV-LICENSE.txt" Pack="true" PackagePath="notices/" />
    <None Include="../../artifacts/native/$(Configuration)/JPVision.Runtime.dll" Link="JPVision.Runtime.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="../../artifacts/native/$(Configuration)/opencv_world500$(_OpenCvSuffix).dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="../../artifacts/native/$(Configuration)/vcruntime*.dll;../../artifacts/native/$(Configuration)/msvcp*.dll;../../artifacts/native/$(Configuration)/concrt*.dll;../../artifacts/native/$(Configuration)/vccorlib*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/win-x64/native/" />
  </ItemGroup>
</Project>
